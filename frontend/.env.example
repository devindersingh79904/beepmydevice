# =============================================================================
# BeepMyDevice - FRONTEND environment
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# Everything here ships inside the app bundle and is readable by anyone who
# downloads it. Only public, client-safe values belong in this file. Server
# secrets (database URL, JWT signing key, Firebase private key, APNs .p8) live
# in backend/.env and must never appear here.
# =============================================================================

# --- API ---------------------------------------------------------------------
# On a physical device localhost points at the device itself. Use your
# machine LAN IP instead, e.g. http://192.168.1.20:8000
API_BASE_URL=http://localhost:8000
API_TIMEOUT=10000

# WebSocket endpoint for live device status. ws:// in dev, wss:// in production.
WS_BASE_URL=ws://localhost:8000

# --- Firebase (Android push) -------------------------------------------------
# Client config only. The private key stays server-side.

# --- Apple (iOS push) --------------------------------------------------------
APPLE_TEAM_ID=XXXXXXXXXX

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG_MODE=true

# --- Device behaviour --------------------------------------------------------
# Must match HEARTBEAT_INTERVAL_SECONDS in the backend constants.
HEARTBEAT_INTERVAL_MS=30000
ERROR_AUTO_CLOSE_MS=5000

# --- Firebase -----------------------------------------------------------------
# Shared across every app in the Firebase project.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Web app registration. NOT used by this app -- @react-native-firebase reads
# google-services.json / GoogleService-Info.plist. Present only so a web target
# added later has somewhere to put its values.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=
