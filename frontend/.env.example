# =============================================================================
# BeepMyDevice - FRONTEND environment
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# Everything here ships inside the app bundle and is readable by anyone who
# downloads it. Only public, client-safe values belong in this file. Server
# secrets (database URL, JWT signing key, Firebase private key, APNs .p8) live
# in backend/.env and must never appear here.
#
# Only what src/ actually reads through react-native-config belongs here. A key
# nothing reads is worse than no key: it invites someone to change it and
# wonder why nothing happened.
# =============================================================================

# --- API ---------------------------------------------------------------------
# On a physical device localhost points at the device itself. Use your
# machine LAN IP instead, e.g. http://192.168.1.20:8000
API_BASE_URL=http://localhost:8000

# WebSocket endpoint for live device status. ws:// in dev, wss:// in production.
WS_BASE_URL=ws://localhost:8000

# --- Firebase -----------------------------------------------------------------
# Reference only. @react-native-firebase reads google-services.json and
# GoogleService-Info.plist, not these -- they are here so the project's
# identifiers are recorded somewhere readable.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Web app registration. Unused: this app has no web target, and a ":web:" app ID
# cannot deliver a push to a phone. Kept so the values are not lost.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=

# Removed deliberately, because nothing read them and the real values live in
# code where both sides can be kept in step:
#   API_TIMEOUT, HEARTBEAT_INTERVAL_MS, ERROR_AUTO_CLOSE_MS
#       -> src/utils/constants.ts (paired with backend/src/utils/constants.py)
#   APPLE_TEAM_ID
#       -> backend/.env; it is a signing credential, not a client value
#   ENVIRONMENT, LOG_LEVEL, DEBUG_MODE
#       -> __DEV__ and the logger already cover this
