<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template only. The real GoogleService-Info.plist comes from the Firebase
  console (Project settings -> Your apps -> iOS) and is gitignored, because it
  is deployment configuration rather than source.

  BUNDLE_ID must equal PRODUCT_BUNDLE_IDENTIFIER in the Xcode project --
  currently com.beepmydevice.app. It is also the APNs topic: when the two
  differ, Apple accepts the push and never delivers it, with no error anywhere.

  Copying the real file into this folder is NOT enough. It has to be added to
  the Xcode target as well, or it is absent from the app bundle and
  [FIRApp configure] raises at launch. See docs/PUSH_SETUP.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.beepmydevice.app</string>
	<key>PROJECT_ID</key>
	<string>your-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>your-project-id.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
