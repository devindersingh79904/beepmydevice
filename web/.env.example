# BeepMyDevice web dashboard — environment template.
#
# Copy to `.env` and fill in. This file is tracked; `.env` is not (`.gitignore`
# matches `.env` and `.env.*`).
#
# Nothing here is a server secret, and nothing here can be. Vite inlines every
# VITE_* variable into the JavaScript bundle at build time, so anything in this
# file is readable by anyone who loads the page — the `VITE_` prefix is the
# guard, not an inconvenience. The real secrets (database URL, JWT signing key,
# Firebase service-account private key, APNs .p8) live in `backend/.env` and
# never reach a browser.
#
# Every value below has a working default in `src/config/env.ts`. A dashboard
# with no `.env` at all still runs, against a same-origin API — a missing
# variable must never be the reason a build breaks.

# --- API ---------------------------------------------------------------------
# Same-origin paths, which is what you want almost always:
#
#   dev  — vite.config.ts proxies /api and /ws to 127.0.0.1:8000
#   prod — web/nginx.conf proxies the same two paths to the api container
#
# Same-origin means no CORS preflight, and a relative WebSocket path inherits
# the page's scheme (wss:// on https), so an https page is never blocked for
# loading a ws:// socket as mixed content.
#
# Set an absolute URL only when the API genuinely lives on another host.
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/status

# --- Firebase (web app registration) ------------------------------------------
# Firebase console → Project settings → Your apps → Web app. Use the SAME
# project as the Android and iOS apps, so the backend sends from and the
# clients receive on one project.
#
# INERT IN PHASE 1. The dashboard's job is to *send* alerts, which it does over
# the REST API with no Firebase involved. Browser push additionally needs a
# VAPID key and a service worker — and a browser cannot read a WiFi BSSID at
# any permission level, so it cannot join a network's alert group at all. See
# src/config/firebase.ts. Leave these blank and everything still works.
VITE_FIREBASE_API_KEY=AIzaSy_your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Web Push certificate key pair: Firebase console → Project settings →
# Cloud Messaging → Web Push certificates → Generate key pair. Without it
# getToken() cannot mint a browser push token.
VITE_FIREBASE_VAPID_KEY=
