# =============================================================================
# BeepMyDevice — BACKEND environment
#
# Copy to .env and fill in real values. NEVER commit .env.
# This file holds server-side secrets only. The frontend has its own
# .env.example with a completely different set of variables.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/beepmydevice_dev

# --- Database connection pool ------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False

# --- JWT authentication ------------------------------------------------------
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# --- Firebase Cloud Messaging (Android push) ---------------------------------
# From the service-account JSON in Firebase Console → Project settings →
# Service accounts. Keep the \n escapes in FIREBASE_PRIVATE_KEY on one line.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# --- Apple Push Notification service (iOS push) ------------------------------
# .p8 token-based auth from Apple Developer → Certificates, IDs & Profiles → Keys
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APPLE_BUNDLE_ID=com.beepmydevice.app
APPLE_USE_SANDBOX=True

# --- Server ------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True
ENVIRONMENT=development

# --- Logging -----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
LOG_FILE_PATH=./logs/beepmydevice.log

# --- CORS --------------------------------------------------------------------
# JSON array of allowed origins. Metro bundler runs on 8081.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- Transactional email (password reset) ------------------------------------
# Optional. With no SMTP_HOST the reset link is written to the log instead of
# emailed, which is enough to exercise the flow in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_ADDRESS=no-reply@beepmydevice.com
PASSWORD_RESET_URL_BASE=https://app.beepmydevice.com/reset-password
